{
  "name": "Angel - Arlo Voice Agent Automation",
  "nodes": [
    {
      "id": "sticky-setup-note",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, -260],
      "parameters": {
        "width": 380,
        "height": 320,
        "content": "## Before this works\n\n1. Open the Webhook node, copy its Production URL, and paste it into every `webhook_url` field in `agent/functions.json` and into `retell-agent-config.json`.\n2. Open the Google Calendar node and connect your own Google account (OAuth) — n8n does not export credentials.\n3. Open both Gmail nodes and connect your own Google account (OAuth).\n4. Replace `YOUR_CALENDAR_ID` in the Google Calendar node with your actual calendar ID (usually your Gmail address).\n5. Activate the workflow (toggle top right) once everything is connected."
      }
    },
    {
      "id": "webhook-node",
      "name": "Angel Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 0],
      "parameters": {
        "path": "angel",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "switch-node",
      "name": "Route by Function",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [40, 0],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{$json.body.name}}",
                    "rightValue": "book_appointment",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "book_appointment"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{$json.body.name}}",
                    "rightValue": "send_confirmation_email",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "send_confirmation_email"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{$json.body.name}}",
                    "rightValue": "take_message",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "take_message"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "gcal-node",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [320, -160],
      "parameters": {
        "operation": "create",
        "calendar": { "value": "YOUR_CALENDAR_ID", "mode": "list" },
        "start": "={{$json.body.args.preferred_datetime}}",
        "end": "={{$json.body.args.preferred_datetime}}",
        "additionalFields": {
          "summary": "=Arlo Demo Call — {{$json.body.args.business_name}}",
          "description": "=Caller: {{$json.body.args.caller_name}}\\nBusiness: {{$json.body.args.business_name}}\\nVertical: {{$json.body.args.vertical}}\\nPhone: {{$json.body.args.phone_number}}\\nNotes: {{$json.body.args.notes}}",
          "attendees": [{ "email": "={{$json.body.args.email}}" }]
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "REPLACE_ME", "name": "Google Calendar account" }
      }
    },
    {
      "id": "respond-book",
      "name": "Respond - Booked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [560, -160],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"result\": \"success\", \"message\": \"Appointment booked\" } }}"
      }
    },
    {
      "id": "gmail-confirmation-node",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [320, 0],
      "parameters": {
        "operation": "send",
        "sendTo": "={{$json.body.args.email}}",
        "subject": "Your demo call with Arlo is confirmed",
        "message": "=Hi {{$json.body.args.caller_name}},<br><br>Thanks for speaking with Angel! Your 30-minute demo call with Saif is confirmed for {{$json.body.args.appointment_datetime}}.<br><br>Talk soon,<br>The Arlo Team",
        "options": { "appendAttribution": false }
      },
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" }
      }
    },
    {
      "id": "respond-confirmation",
      "name": "Respond - Confirmation Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [560, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"result\": \"success\", \"message\": \"Confirmation email sent\" } }}"
      }
    },
    {
      "id": "gmail-message-node",
      "name": "Notify Saif",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [320, 160],
      "parameters": {
        "operation": "send",
        "sendTo": "saifarshad674@gmail.com",
        "subject": "=New Arlo lead from Angel — {{$json.body.args.urgency}}",
        "message": "=Name: {{$json.body.args.caller_name}}<br>Business: {{$json.body.args.business_name}}<br>Phone: {{$json.body.args.phone_number}}<br>Urgency: {{$json.body.args.urgency}}<br><br>Summary:<br>{{$json.body.args.summary}}",
        "options": { "appendAttribution": false }
      },
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" }
      }
    },
    {
      "id": "respond-message",
      "name": "Respond - Message Logged",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [560, 160],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"result\": \"success\", \"message\": \"Message logged\" } }}"
      }
    }
  ],
  "connections": {
    "Angel Webhook": {
      "main": [[{ "node": "Route by Function", "type": "main", "index": 0 }]]
    },
    "Route by Function": {
      "main": [
        [{ "node": "Create Calendar Event", "type": "main", "index": 0 }],
        [{ "node": "Send Confirmation Email", "type": "main", "index": 0 }],
        [{ "node": "Notify Saif", "type": "main", "index": 0 }]
      ]
    },
    "Create Calendar Event": {
      "main": [[{ "node": "Respond - Booked", "type": "main", "index": 0 }]]
    },
    "Send Confirmation Email": {
      "main": [[{ "node": "Respond - Confirmation Sent", "type": "main", "index": 0 }]]
    },
    "Notify Saif": {
      "main": [[{ "node": "Respond - Message Logged", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
