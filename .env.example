# ---------------------------------------------------------------------------
# Minimum for the browser demo (no phone number needed): the first three.
# Add the Twilio block to take real inbound calls.
# ---------------------------------------------------------------------------

# --- Claude (required) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# claude-opus-5 is the default. claude-haiku-4-5 typically saves 200-400ms on
# time-to-first-token; measure on your own script before switching, the gap
# shows up most on messy, interrupted callers.
# ANTHROPIC_MODEL=claude-opus-5

# low | medium | high. `low` keeps turns snappy, which is what a scripted
# intake call needs. Thinking stays on either way — see src/agent/brain.ts.
# ANTHROPIC_EFFORT=low

# --- Speech to text (required) ---
# https://console.deepgram.com/
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# Silence (ms) before an utterance is finalised. Lower = snappier but cuts
# people off mid-sentence, which is worse. 800 is a sane starting point.
# DEEPGRAM_ENDPOINTING_MS=800
# DEEPGRAM_UTTERANCE_END_MS=1000

# --- Text to speech (required) ---
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Pick a British voice from https://elevenlabs.io/app/voice-library
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# eleven_flash_v2_5 is lowest latency; eleven_turbo_v2_5 trades ~80ms for nuance.
# ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Telephony (only for real phone calls) ---
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS origin Twilio dials back into. With ngrok: https://xxxx.ngrok.app
PUBLIC_URL=
# Set to false ONLY for local testing without Twilio. Never in production —
# it lets anyone who finds the URL drive your agent and your Anthropic spend.
# TWILIO_VALIDATE_SIGNATURE=true

# Where "put me through to a person" lands, in E.164.
# HUMAN_HANDOFF_NUMBER=+442034328551

# --- Optional ---
# Free key for live company-name availability against the real register:
# https://developer.company-information.service.gov.uk/
# Without it, name checking still applies all the offline Companies House rules
# (suffix, sensitive words, permitted characters) but cannot detect a clash.
# COMPANIES_HOUSE_API_KEY=

# AGENT_NAME=Robin
# PORT=3000
# LOG_LEVEL=info
# LEADS_FILE=data/leads.jsonl
# Recordings are personal data — off by default.
# RECORD_CALLS=false
