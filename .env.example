# Copy this file to .env and fill in once you've created the accounts below.
# Nothing in this repo reads these automatically yet — they're the reference
# list of every credential the Angel demo needs, gathered in one place.

# Retell AI (https://www.retellai.com) — voice agent platform
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_PHONE_NUMBER=

# n8n Cloud (https://n8n.io) — automation, connects Retell to Calendar/Gmail
N8N_WEBHOOK_URL=

# Google Calendar + Gmail — connected via OAuth inside n8n's UI directly,
# no keys needed here. Use the Google account that owns Saif's calendar.
GOOGLE_CALENDAR_ID=

# Where Saif gets lead notifications and take_message alerts
SAIF_NOTIFICATION_EMAIL=saifarshad674@gmail.com
